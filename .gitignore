# the logged-in browser session — never commit this
.browser-profile/

# python
.venv/
__pycache__/
*.pyc

# local env
.env
.finder.env

# OAuth state: registered clients + issued access/refresh tokens — secrets
.oauth-store.json
.oauth-store.tmp

# runtime logs
*.log
logs/

# relay (Cloudflare Worker) build + local state
relay/node_modules/
relay/.wrangler/
relay/.dev.vars
node_modules/

# server-side radius filter geocode memo
.geocode-cache.json

# per-friend device-token bundles minted by `./finder provision` — secrets
.provision/
