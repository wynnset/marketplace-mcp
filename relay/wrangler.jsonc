{
  // marketplace-relay — one URL for every friend's Mac (see src/index.ts).
  // Deploy:  cd relay && npx wrangler deploy
  // Dev:     cd relay && npx wrangler dev --port 8787
  "name": "marketplace-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayDO" }]
  },

  // SQLite-backed DO classes (required for the free plan).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayDO"] }
  ],

  // KV: OAUTH_KV is the @cloudflare/workers-oauth-provider grant/client/token store;
  // RELAY_KV holds our own state (in-flight authorize `state`; Step-3 device-token
  // revocation denylist). `id` values are placeholders — `wrangler dev` ignores them
  // and uses a local store; fill real ids (`wrangler kv namespace create`) before
  // deploying in Step 5.
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "5528ced95173472ea7b544c17188c85e" },
    { "binding": "RELAY_KV", "id": "c1277ed6a8d94b89b431059c2f1c8119" }
  ],

  // Non-secret config. PUBLIC_URL is the relay's public base (issuer + Google
  // redirect origin). Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // MCP_ALLOWED_EMAILS, RELAY_JWT_SECRET) are set via `wrangler secret put`, never
  // committed. For local dev, put them in relay/.dev.vars (gitignored).
  "vars": {
    "PUBLIC_URL": "https://mcp.wynnset.com"
  },

  // Single public endpoint for every friend's Mac. custom_domain makes wrangler
  // provision the hostname + its DNS on deploy. NOTE: mcp.wynnset.com is currently
  // the old cloudflared tunnel host — that DNS record must be removed first or the
  // custom-domain creation will conflict (see docs/RELAY_DEPLOY.md → cutover).
  "routes": [
    { "pattern": "mcp.wynnset.com", "custom_domain": true }
  ]
}
