#!/usr/bin/env bash
#
# finder — one command to install, run, and manage the Marketplace Finder MCP
# server + its Cloudflare tunnel on your Mac.
#
# The goal: after `./finder install` you have a PERMANENT URL
# (https://mcp.<your-domain>/mcp) that auto-starts at login and self-heals if it
# crashes. You paste that URL into claude.ai once and never touch it again.
#
# Subcommands:
#   ./finder install     one-time setup: deps, Facebook login, Cloudflare tunnel,
#                         and auto-start services. Safe to re-run (idempotent).
#   ./finder start        start the server + tunnel services
#   ./finder stop         stop them
#   ./finder restart      restart them
#   ./finder status       show health + your permanent connector URL
#   ./finder logs         tail the server + tunnel logs
#   ./finder url          print the claude.ai connector URL
#   ./finder login        re-log into Facebook (when the session expires)
#   ./finder provision <email>   mint a friend's relay device token + bundle (relay model)
#   ./finder uninstall    remove the auto-start services (keeps your code/login)
#
set -euo pipefail

# ─── paths & constants ────────────────────────────────────────────────────────
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$REPO/.venv"
PY="$VENV/bin/python"
CONFIG="$REPO/.finder.env"            # gitignored; remembers your domain/hostname
CF_DIR="$HOME/.cloudflared"
TUNNEL_NAME="marketplace-mcp"
CF_CONFIG="$CF_DIR/$TUNNEL_NAME.yml"
LA_DIR="$HOME/Library/LaunchAgents"
SERVER_LABEL="com.wynnset.finder.server"
TUNNEL_LABEL="com.wynnset.finder.tunnel"
SERVER_PLIST="$LA_DIR/$SERVER_LABEL.plist"
TUNNEL_PLIST="$LA_DIR/$TUNNEL_LABEL.plist"
GUI="gui/$(id -u)"
PORT="${MCP_PORT:-8000}"

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '\033[33m!\033[0m %s\n' "$1"; }
err()  { printf '\033[31m✗\033[0m %s\n' "$1" >&2; }
die()  { err "$1"; exit 1; }

CLOUDFLARED="$(command -v cloudflared || true)"

# ─── config persistence (domain / hostname) ───────────────────────────────────
load_config() { [ -f "$CONFIG" ] && set -a && . "$CONFIG" && set +a || true; }

save_config() {
  # Note: this file holds your Google client secret — it is gitignored and
  # readable only by you. Treat it like a password.
  cat > "$CONFIG" <<EOF
# Written by ./finder install — your permanent endpoint settings.
FINDER_HOSTNAME="$FINDER_HOSTNAME"
GOOGLE_CLIENT_ID="${GOOGLE_CLIENT_ID:-}"
GOOGLE_CLIENT_SECRET="${GOOGLE_CLIENT_SECRET:-}"
MCP_ALLOWED_EMAILS="${MCP_ALLOWED_EMAILS:-}"
# Relay model (Step 5): the agent dials this URL; RELAY_JWT_SECRET is shared with
# the relay Worker (wrangler secret put RELAY_JWT_SECRET). Preserved across re-runs.
RELAY_URL="${RELAY_URL:-}"
RELAY_JWT_SECRET="${RELAY_JWT_SECRET:-}"
EOF
  chmod 600 "$CONFIG" 2>/dev/null || true
}

# ─── bootstrap: venv + python deps + chromium ─────────────────────────────────
bootstrap_python() {
  bold "1/5  Python environment"
  command -v python3 >/dev/null || die "python3 not found. Install Python 3.10+ first."
  if [ ! -x "$PY" ]; then
    python3 -m venv "$VENV"
    ok "created virtualenv (.venv)"
  else
    ok "virtualenv present"
  fi
  "$PY" -m pip install --quiet --upgrade pip
  "$PY" -m pip install --quiet -r "$REPO/requirements.txt"
  ok "python dependencies installed"
  # Install Chromium only if Playwright can't find it yet (idempotent + cheap to recheck).
  if [ ! -d "$HOME/Library/Caches/ms-playwright" ] || \
     [ -z "$(ls -A "$HOME/Library/Caches/ms-playwright" 2>/dev/null | grep -i chromium || true)" ]; then
    bold "    downloading Chromium (~150 MB, one time)…"
    "$PY" -m playwright install chromium
  fi
  ok "Chromium ready"
}

# ─── Facebook login (only if no saved session yet) ────────────────────────────
ensure_fb_login() {
  bold "2/5  Facebook session"
  if [ -d "$REPO/.browser-profile" ]; then
    ok "logged-in browser profile found (re-run './finder login' if FB logs you out)"
    return
  fi
  warn "no saved Facebook session — opening a browser to log in"
  echo "    A Chrome window will open. Log into Facebook, then close the window."
  read -r -p "    Press Enter to open the login browser… " _ || true
  "$PY" "$REPO/src/server.py" login
  ok "Facebook session saved"
}

# ─── Cloudflare named tunnel (permanent URL) ──────────────────────────────────
ensure_tunnel() {
  bold "3/5  Cloudflare tunnel (your permanent URL)"
  [ -n "$CLOUDFLARED" ] || die "cloudflared not found. Install it:  brew install cloudflared"

  # Hostname: mcp.<your-domain>. Ask once, remember it.
  if [ -z "${FINDER_HOSTNAME:-}" ]; then
    echo "    Your permanent endpoint will be https://<hostname>/mcp"
    echo "    The domain must be one you manage in Cloudflare DNS (e.g. wynnset.com)."
    read -r -p "    Hostname to use [mcp.wynnset.com]: " FINDER_HOSTNAME
    FINDER_HOSTNAME="${FINDER_HOSTNAME:-mcp.wynnset.com}"
  fi
  save_config
  ok "hostname: $FINDER_HOSTNAME"

  # Authorize cloudflared to a zone (browser, one time).
  if [ ! -f "$CF_DIR/cert.pem" ]; then
    warn "cloudflared isn't authorized yet — a browser will open"
    echo "    Pick the domain that owns '$FINDER_HOSTNAME' and Authorize."
    read -r -p "    Press Enter to open the Cloudflare login… " _ || true
    "$CLOUDFLARED" tunnel login
  fi
  [ -f "$CF_DIR/cert.pem" ] || die "Cloudflare authorization (cert.pem) not found — re-run and complete the browser step."
  ok "cloudflared authorized"

  # Create the named tunnel if it doesn't already exist.
  if "$CLOUDFLARED" tunnel list 2>/dev/null | awk '{print $2}' | grep -qx "$TUNNEL_NAME"; then
    ok "tunnel '$TUNNEL_NAME' already exists"
  else
    "$CLOUDFLARED" tunnel create "$TUNNEL_NAME"
    ok "tunnel '$TUNNEL_NAME' created"
  fi

  # Resolve the credentials file (…/<UUID>.json) for this tunnel.
  local uuid creds
  uuid="$("$CLOUDFLARED" tunnel list 2>/dev/null | awk -v n="$TUNNEL_NAME" '$2==n{print $1}' | head -1)"
  [ -n "$uuid" ] || die "couldn't determine tunnel UUID for '$TUNNEL_NAME'"
  creds="$CF_DIR/$uuid.json"
  [ -f "$creds" ] || die "tunnel credentials not found at $creds"

  # Write the ingress config: route the public hostname to the local server.
  cat > "$CF_CONFIG" <<EOF
# Written by ./finder install — maps $FINDER_HOSTNAME to the local MCP server.
tunnel: $TUNNEL_NAME
credentials-file: $creds
ingress:
  - hostname: $FINDER_HOSTNAME
    service: http://localhost:$PORT
  - service: http_status:404
EOF
  ok "tunnel config written ($CF_CONFIG)"

  # Point the DNS record at the tunnel (idempotent; tolerate "already exists").
  if "$CLOUDFLARED" tunnel route dns "$TUNNEL_NAME" "$FINDER_HOSTNAME" 2>/tmp/finder-dns.$$; then
    ok "DNS routed: $FINDER_HOSTNAME → tunnel"
  else
    if grep -qi "already exists\|record with that host" /tmp/finder-dns.$$; then
      ok "DNS already routed for $FINDER_HOSTNAME"
    else
      warn "DNS route step reported:"; sed 's/^/      /' /tmp/finder-dns.$$
      warn "If '$FINDER_HOSTNAME' already points elsewhere, fix it in the Cloudflare dashboard (CNAME → $uuid.cfargotunnel.com)."
    fi
  fi
  rm -f /tmp/finder-dns.$$
}

# ─── Google sign-in lockdown (optional but recommended) ───────────────────────
ensure_oauth() {
  bold "4/5  Access control (Google sign-in)"
  if [ -n "${GOOGLE_CLIENT_ID:-}" ] && [ -n "${MCP_ALLOWED_EMAILS:-}" ]; then
    ok "Google sign-in already configured (emails: $MCP_ALLOWED_EMAILS)"
    echo "    Re-run with no config to change it, or edit $CONFIG."
    return
  fi
  echo "    Without this, ANYONE who learns your URL can drive your logged-in"
  echo "    Facebook session. Lock it to your Google account instead (recommended)."
  echo
  echo "    One-time Google Cloud setup (https://console.cloud.google.com/apis/credentials):"
  echo "      • Create an OAuth 2.0 Client ID, type 'Web application'"
  echo "      • Add this Authorized redirect URI exactly:"
  echo "            https://$FINDER_HOSTNAME/oauth/google/callback"
  echo "      • Copy the Client ID and Client secret it gives you"
  echo
  read -r -p "    Configure Google sign-in now? [Y/n]: " _ans || true
  case "${_ans:-Y}" in
    [Nn]*) warn "skipping — server will run OPEN (secured only by the secret URL)"; return ;;
  esac
  read -r -p "    Google Client ID: " GOOGLE_CLIENT_ID
  read -r -p "    Google Client secret: " GOOGLE_CLIENT_SECRET
  read -r -p "    Allowed email(s), comma-separated [aidin@wynnset.com]: " MCP_ALLOWED_EMAILS
  MCP_ALLOWED_EMAILS="${MCP_ALLOWED_EMAILS:-aidin@wynnset.com}"
  [ -n "$GOOGLE_CLIENT_ID" ] && [ -n "$GOOGLE_CLIENT_SECRET" ] || die "Client ID and secret are required (or answer 'n' to skip)."
  export GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET MCP_ALLOWED_EMAILS
  save_config
  ok "Google sign-in configured (emails: $MCP_ALLOWED_EMAILS)"
}

# ─── launchd services (auto-start at login, self-heal) ────────────────────────
write_plists() {
  # Inject the OAuth env vars into the server plist only when configured.
  local oauth_env=""
  if [ -n "${GOOGLE_CLIENT_ID:-}" ]; then
    oauth_env="    <key>GOOGLE_CLIENT_ID</key><string>${GOOGLE_CLIENT_ID}</string>
    <key>GOOGLE_CLIENT_SECRET</key><string>${GOOGLE_CLIENT_SECRET}</string>
    <key>MCP_ALLOWED_EMAILS</key><string>${MCP_ALLOWED_EMAILS}</string>
    <key>MCP_PUBLIC_URL</key><string>https://${FINDER_HOSTNAME}</string>"
  fi
  mkdir -p "$LA_DIR" "$REPO/logs"
  cat > "$SERVER_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$SERVER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$PY</string>
    <string>$REPO/src/server.py</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key><string>$REPO</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MCP_HOST</key><string>127.0.0.1</string>
    <key>MCP_PORT</key><string>$PORT</string>
    <key>MCP_ALLOWED_HOSTS</key><string>$FINDER_HOSTNAME</string>
    <key>FB_HEADLESS</key><string>1</string>
$oauth_env
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$REPO/logs/server.out.log</string>
  <key>StandardErrorPath</key><string>$REPO/logs/server.err.log</string>
</dict></plist>
EOF

  cat > "$TUNNEL_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$TUNNEL_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$CLOUDFLARED</string>
    <string>tunnel</string>
    <string>--no-autoupdate</string>
    <string>--config</string>
    <string>$CF_CONFIG</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$REPO/logs/tunnel.out.log</string>
  <key>StandardErrorPath</key><string>$REPO/logs/tunnel.err.log</string>
</dict></plist>
EOF
}

boot_service() {  # bootstrap (load) a plist, replacing any existing instance
  local label="$1" plist="$2"
  launchctl bootout "$GUI/$label" 2>/dev/null || true
  launchctl bootstrap "$GUI" "$plist"
}

install_services() {
  bold "5/5  Auto-start services"
  write_plists
  boot_service "$SERVER_LABEL" "$SERVER_PLIST"
  boot_service "$TUNNEL_LABEL" "$TUNNEL_PLIST"
  ok "services installed and started (auto-start at login is on)"
}

# ─── service control ──────────────────────────────────────────────────────────
require_installed() {
  [ -f "$SERVER_PLIST" ] || die "Not installed yet. Run:  ./finder install"
}

svc_start()   { require_installed; boot_service "$SERVER_LABEL" "$SERVER_PLIST"; boot_service "$TUNNEL_LABEL" "$TUNNEL_PLIST"; ok "started"; }
svc_stop()    { launchctl bootout "$GUI/$SERVER_LABEL" 2>/dev/null || true; launchctl bootout "$GUI/$TUNNEL_LABEL" 2>/dev/null || true; ok "stopped"; }
svc_restart() { launchctl kickstart -k "$GUI/$SERVER_LABEL" 2>/dev/null || svc_start; launchctl kickstart -k "$GUI/$TUNNEL_LABEL" 2>/dev/null || true; ok "restarted"; }

cmd_status() {
  load_config
  bold "Marketplace Finder — status"
  # local server
  local code
  code="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$PORT/mcp" 2>/dev/null || echo 000)"
  if [ "$code" != "000" ]; then ok "local server: up (http://127.0.0.1:$PORT/mcp → HTTP $code)"
  else err "local server: DOWN"; fi
  # launchd
  if launchctl print "$GUI/$SERVER_LABEL" >/dev/null 2>&1; then ok "server service: loaded"; else warn "server service: not loaded"; fi
  if launchctl print "$GUI/$TUNNEL_LABEL" >/dev/null 2>&1; then ok "tunnel service: loaded"; else warn "tunnel service: not loaded"; fi
  # access control
  if [ -n "${GOOGLE_CLIENT_ID:-}" ] && [ -n "${MCP_ALLOWED_EMAILS:-}" ]; then
    ok "access: Google sign-in (allowed: $MCP_ALLOWED_EMAILS)"
  else
    warn "access: OPEN — anyone with the URL can use it. Run ./finder install to add Google sign-in."
  fi
  # public endpoint
  if [ -n "${FINDER_HOSTNAME:-}" ]; then
    local pub
    pub="$(curl -s -m 8 -o /dev/null -w '%{http_code}' "https://$FINDER_HOSTNAME/mcp" 2>/dev/null || echo 000)"
    if [ "$pub" != "000" ]; then ok "public endpoint: reachable (https://$FINDER_HOSTNAME/mcp → HTTP $pub)"
    else warn "public endpoint: not reachable yet (DNS can take a minute on first setup)"; fi
    echo; bold "Connector URL for claude.ai:"; echo "    https://$FINDER_HOSTNAME/mcp"
  else
    warn "no hostname configured — run ./finder install"
  fi
}

cmd_url() { load_config; [ -n "${FINDER_HOSTNAME:-}" ] && echo "https://$FINDER_HOSTNAME/mcp" || die "Not configured. Run ./finder install"; }

cmd_logs() {
  bold "Tailing logs (Ctrl-C to stop)…"
  touch "$REPO/logs/server.err.log" "$REPO/logs/tunnel.err.log" "$REPO/server.log" 2>/dev/null || true
  tail -f "$REPO/server.log" "$REPO/logs/server.err.log" "$REPO/logs/tunnel.err.log"
}

cmd_login() {
  bold "Re-logging into Facebook"
  warn "stopping the server so it releases the browser profile…"
  launchctl bootout "$GUI/$SERVER_LABEL" 2>/dev/null || true
  [ -x "$PY" ] || die "Run ./finder install first."
  "$PY" "$REPO/src/server.py" login
  if [ -f "$SERVER_PLIST" ]; then boot_service "$SERVER_LABEL" "$SERVER_PLIST"; ok "server restarted"; fi
}

# ─── Step 5: provision a friend's device token (single-relay model) ───────────
# Additive and non-destructive: this does NOT touch the existing cloudflared
# tunnel / launchd flow. It mints an HS256 device token (src/devtoken.py) that the
# relay Worker verifies on /agent, and writes a per-friend bundle the installer
# ships. Requires RELAY_JWT_SECRET (shared with the Worker) and RELAY_URL in
# .finder.env. The Worker deploy + cloudflared removal are separate (gated) steps.
PROVISION_DIR="$REPO/.provision"

cmd_provision() {
  load_config
  local email="${1:-}"
  [ -n "$email" ] || die "usage: ./finder provision <email>"
  email="$(printf '%s' "$email" | tr '[:upper:]' '[:lower:]')"
  [ -n "${RELAY_JWT_SECRET:-}" ] || die "RELAY_JWT_SECRET not set — add it to $CONFIG (the secret shared with the relay Worker)."
  local relay_url="${RELAY_URL:-}"
  if [ -z "$relay_url" ] && [ -n "${FINDER_HOSTNAME:-}" ]; then
    relay_url="wss://$FINDER_HOSTNAME/agent"
  fi
  [ -n "$relay_url" ] || die "RELAY_URL not set — add it to $CONFIG (e.g. wss://mcp.wynnset.com/agent)."
  [ -x "$PY" ] || die "No .venv yet — run ./finder install first."

  local token
  token="$(RELAY_JWT_SECRET="$RELAY_JWT_SECRET" "$PY" "$REPO/src/devtoken.py" "$email")" \
    || die "could not mint device token (is RELAY_JWT_SECRET set?)"

  mkdir -p "$PROVISION_DIR"
  local safe bundle
  safe="$(printf '%s' "$email" | tr -c 'a-z0-9' '_')"
  bundle="$PROVISION_DIR/$safe.env"
  cat > "$bundle" <<EOF
# Device credentials for $email — relay reverse-tunnel client.
# SECRET: treat like a password. The friend's Mac reads these to dial the relay.
RELAY_URL="$relay_url"
RELAY_DEVICE_TOKEN="$token"
EOF
  chmod 600 "$bundle" 2>/dev/null || true

  ok "provisioned $email"
  echo "    bundle: $bundle"
  echo "    relay : $relay_url"
  echo
  warn "two things still needed:"
  echo "    1. Add '$email' to the relay Worker allowlist (MCP_ALLOWED_EMAILS) — it"
  echo "       must match the email they sign into Google with, exactly."
  echo "    2. Ship this bundle inside their installer (Step 5 packaging)."
}

cmd_uninstall() {
  bold "Removing auto-start services"
  svc_stop
  rm -f "$SERVER_PLIST" "$TUNNEL_PLIST"
  ok "services removed (your code, Facebook login, and Cloudflare tunnel are untouched)"
  echo "    To also delete the Cloudflare tunnel:  cloudflared tunnel delete $TUNNEL_NAME"
}

cmd_install() {
  load_config
  bold "Installing Marketplace Finder (permanent URL + auto-start)"
  echo
  bootstrap_python
  echo
  ensure_fb_login
  echo
  ensure_tunnel
  echo
  ensure_oauth
  echo
  install_services
  echo
  bold "Done. 🎉  Give DNS/tunnel ~30s, then check:"
  echo "    ./finder status"
  echo
  bold "Add this ONE URL to claude.ai → Settings → Connectors (never changes):"
  echo "    https://$FINDER_HOSTNAME/mcp"
}

usage() {
  # Print the leading comment block (skip the shebang + the first bare `#`).
  awk 'NR<=2{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"
}

# ─── dispatch ─────────────────────────────────────────────────────────────────
load_config
case "${1:-}" in
  install)   cmd_install ;;
  start)     svc_start ;;
  stop)      svc_stop ;;
  restart)   svc_restart ;;
  status)    cmd_status ;;
  url)       cmd_url ;;
  logs)      cmd_logs ;;
  login)     cmd_login ;;
  provision) cmd_provision "${2:-}" ;;
  uninstall) cmd_uninstall ;;
  ""|-h|--help|help) usage ;;
  *) err "unknown command: $1"; echo; usage; exit 1 ;;
esac
