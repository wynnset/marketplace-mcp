#!/usr/bin/env bash
#
# finder — install, run, and manage the Marketplace Finder relay agent on your Mac.
#
# Relay model: a single shared Cloudflare Worker (https://mcp.<domain>/mcp) handles
# Google sign-in and routes each claude.ai request to the right Mac by identity. This
# Mac runs an OUTBOUND agent (relay/relay_client.py) that dials the relay over a
# WebSocket and serves your logged-in Facebook session — no inbound tunnel, no public
# address on this machine. (The old per-Mac cloudflared tunnel is gone.)
#
# Subcommands:
#   ./finder install     one-time setup: deps, Facebook login, auto-start agent.
#   ./finder start        start the agent service
#   ./finder stop         stop it
#   ./finder restart      restart it
#   ./finder status       show agent health + your connector URL
#   ./finder logs         tail the agent logs
#   ./finder url          print the claude.ai connector URL
#   ./finder login        re-log into Facebook (when the session expires)
#   ./finder provision <email>   (operator) mint a friend's relay device token + bundle
#   ./finder uninstall    remove the auto-start agent (keeps your code/login)
#
set -euo pipefail

# ─── paths & constants ────────────────────────────────────────────────────────
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$REPO/.venv"
PY="$VENV/bin/python"
CONFIG="$REPO/.finder.env"            # gitignored; holds RELAY_URL + device token (secrets)
LA_DIR="$HOME/Library/LaunchAgents"
AGENT_LABEL="com.wynnset.finder.server"   # kept for continuity; now runs relay_client
AGENT_PLIST="$LA_DIR/$AGENT_LABEL.plist"
OLD_TUNNEL_LABEL="com.wynnset.finder.tunnel"  # pre-relay; cleaned up on install/uninstall
OLD_TUNNEL_PLIST="$LA_DIR/$OLD_TUNNEL_LABEL.plist"
GUI="gui/$(id -u)"

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '\033[33m!\033[0m %s\n' "$1"; }
err()  { printf '\033[31m✗\033[0m %s\n' "$1" >&2; }
die()  { err "$1"; exit 1; }

# ─── config persistence ───────────────────────────────────────────────────────
load_config() { [ -f "$CONFIG" ] && set -a && . "$CONFIG" && set +a || true; }

save_config() {
  # Secrets (device token; operator's Worker creds) — gitignored, owner-only.
  cat > "$CONFIG" <<EOF
# Written by ./finder — relay agent settings (treat as secrets).
# This Mac's agent dials RELAY_URL and authenticates with RELAY_DEVICE_TOKEN.
RELAY_URL="${RELAY_URL:-}"
RELAY_DEVICE_TOKEN="${RELAY_DEVICE_TOKEN:-}"
# Operator-only (used by 'finder provision' + the Worker's 'wrangler secret put',
# NOT by this Mac's agent). Harmless to leave blank on a friend's Mac.
RELAY_JWT_SECRET="${RELAY_JWT_SECRET:-}"
GOOGLE_CLIENT_ID="${GOOGLE_CLIENT_ID:-}"
GOOGLE_CLIENT_SECRET="${GOOGLE_CLIENT_SECRET:-}"
MCP_ALLOWED_EMAILS="${MCP_ALLOWED_EMAILS:-}"
EOF
  chmod 600 "$CONFIG" 2>/dev/null || true
}

# host (mcp.<domain>) parsed from RELAY_URL (wss://host/agent), and the connector URL.
relay_host()    { printf '%s' "${RELAY_URL:-}" | sed -E 's#^wss?://##; s#/.*$##'; }
connector_url() { local h; h="$(relay_host)"; [ -n "$h" ] && echo "https://$h/mcp"; }

# ─── bootstrap: venv + python deps + chromium ─────────────────────────────────
bootstrap_python() {
  bold "1/3  Python environment"
  command -v python3 >/dev/null || die "python3 not found. Install Python 3.10+ first."
  if [ ! -x "$PY" ]; then
    python3 -m venv "$VENV"
    ok "created virtualenv (.venv)"
  else
    ok "virtualenv present"
  fi
  "$PY" -m pip install --quiet --upgrade pip
  "$PY" -m pip install --quiet -r "$REPO/requirements.txt"
  ok "python dependencies installed"
  if [ ! -d "$HOME/Library/Caches/ms-playwright" ] || \
     [ -z "$(ls -A "$HOME/Library/Caches/ms-playwright" 2>/dev/null | grep -i chromium || true)" ]; then
    bold "    downloading Chromium (~150 MB, one time)…"
    "$PY" -m playwright install chromium
  fi
  ok "Chromium ready"
}

# ─── Facebook login (only if no saved session yet) ────────────────────────────
ensure_fb_login() {
  bold "2/3  Facebook session"
  if [ -d "$REPO/.browser-profile" ]; then
    ok "logged-in browser profile found (re-run './finder login' if FB logs you out)"
    return
  fi
  warn "no saved Facebook session — opening a browser to log in"
  echo "    A Chrome window will open. Log into Facebook, then close the window."
  read -r -p "    Press Enter to open the login browser… " _ || true
  "$PY" "$REPO/src/server.py" login
  ok "Facebook session saved"
}

# ─── relay credentials (from your device bundle) ──────────────────────────────
ensure_relay_config() {
  bold "3/3  Relay connection"
  if [ -z "${RELAY_URL:-}" ] || [ -z "${RELAY_DEVICE_TOKEN:-}" ]; then
    err "Missing relay credentials in $CONFIG"
    echo "    This Mac needs RELAY_URL + RELAY_DEVICE_TOKEN — they come from the device"
    echo "    bundle the operator created with:  ./finder provision <your-email>"
    echo "    (that writes .provision/<email>.env). Copy both lines into $CONFIG, e.g.:"
    echo "        RELAY_URL=\"wss://mcp.wynnset.com/agent\""
    echo "        RELAY_DEVICE_TOKEN=\"<token>\""
    die "add RELAY_URL + RELAY_DEVICE_TOKEN to $CONFIG, then re-run ./finder install"
  fi
  ok "relay: $(relay_host)"
}

# ─── launchd agent (auto-start at login, self-heal, keep the Mac awake) ────────
write_plist() {
  mkdir -p "$LA_DIR" "$REPO/logs"
  # caffeinate -is keeps the Mac awake (idle + system) while the agent runs, so a
  # closed-lid/idle Mac still answers searches. Works while the Mac is on + online.
  cat > "$AGENT_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$AGENT_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-is</string>
    <string>$PY</string>
    <string>$REPO/relay/relay_client.py</string>
  </array>
  <key>WorkingDirectory</key><string>$REPO</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RELAY_URL</key><string>${RELAY_URL}</string>
    <key>RELAY_DEVICE_TOKEN</key><string>${RELAY_DEVICE_TOKEN}</string>
    <key>FB_HEADLESS</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$REPO/logs/agent.out.log</string>
  <key>StandardErrorPath</key><string>$REPO/logs/agent.err.log</string>
</dict></plist>
EOF
  chmod 600 "$AGENT_PLIST" 2>/dev/null || true   # contains the device token
}

boot_service() {  # bootstrap (load) a plist, replacing any existing instance
  local label="$1" plist="$2"
  launchctl bootout "$GUI/$label" 2>/dev/null || true
  launchctl bootstrap "$GUI" "$plist"
}

cleanup_old_tunnel() {  # remove the pre-relay cloudflared LaunchAgent if present
  if [ -f "$OLD_TUNNEL_PLIST" ] || launchctl print "$GUI/$OLD_TUNNEL_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$GUI/$OLD_TUNNEL_LABEL" 2>/dev/null || true
    rm -f "$OLD_TUNNEL_PLIST"
    ok "removed old cloudflared tunnel service (relay model no longer needs it)"
  fi
}

install_service() {
  bold "Auto-start agent"
  cleanup_old_tunnel
  write_plist
  boot_service "$AGENT_LABEL" "$AGENT_PLIST"
  ok "agent installed and started (auto-start at login is on)"
}

# ─── service control ──────────────────────────────────────────────────────────
require_installed() { [ -f "$AGENT_PLIST" ] || die "Not installed yet. Run:  ./finder install"; }
svc_start()   { require_installed; boot_service "$AGENT_LABEL" "$AGENT_PLIST"; ok "started"; }
svc_stop()    { launchctl bootout "$GUI/$AGENT_LABEL" 2>/dev/null || true; ok "stopped"; }
svc_restart() { require_installed; launchctl kickstart -k "$GUI/$AGENT_LABEL" 2>/dev/null || svc_start; ok "restarted"; }

cmd_status() {
  load_config
  bold "Marketplace Finder (relay agent) — status"
  if launchctl print "$GUI/$AGENT_LABEL" >/dev/null 2>&1; then ok "agent service: loaded"; else warn "agent service: not loaded (run ./finder install)"; fi
  if pgrep -f "relay/relay_client.py" >/dev/null 2>&1; then ok "agent process: running (dialing $(relay_host))"; else warn "agent process: not running"; fi
  local url; url="$(connector_url)"
  if [ -n "$url" ]; then
    # 401 is HEALTHY here — the relay is up and enforcing the OAuth gate.
    local code; code="$(curl -s -m 8 -o /dev/null -w '%{http_code}' -X POST "$url" 2>/dev/null || echo 000)"
    case "$code" in
      401|200) ok "relay endpoint: up ($url → HTTP $code)";;
      000)     warn "relay endpoint: unreachable ($url)";;
      *)       warn "relay endpoint: $url → HTTP $code";;
    esac
    echo; bold "Connector URL for claude.ai:"; echo "    $url"
  else
    warn "RELAY_URL not configured — see $CONFIG"
  fi
}

cmd_url() { load_config; local u; u="$(connector_url)"; [ -n "$u" ] && echo "$u" || die "Not configured. Run ./finder install"; }

cmd_logs() {
  bold "Tailing logs (Ctrl-C to stop)…"
  touch "$REPO/logs/agent.err.log" "$REPO/server.log" 2>/dev/null || true
  tail -f "$REPO/server.log" "$REPO/logs/agent.err.log"
}

cmd_login() {
  bold "Re-logging into Facebook"
  warn "stopping the agent so it releases the browser profile…"
  launchctl bootout "$GUI/$AGENT_LABEL" 2>/dev/null || true
  [ -x "$PY" ] || die "Run ./finder install first."
  "$PY" "$REPO/src/server.py" login
  if [ -f "$AGENT_PLIST" ]; then boot_service "$AGENT_LABEL" "$AGENT_PLIST"; ok "agent restarted"; fi
}

# ─── operator: provision a friend's device token (single-relay model) ─────────
# Mints an HS256 device token (src/devtoken.py) that the relay Worker verifies on
# /agent, and writes a per-friend bundle. Requires RELAY_JWT_SECRET (shared with the
# Worker) and RELAY_URL in .finder.env. Run on the OPERATOR's Mac, not a friend's.
PROVISION_DIR="$REPO/.provision"

cmd_provision() {
  load_config
  local email="${1:-}"
  [ -n "$email" ] || die "usage: ./finder provision <email>"
  email="$(printf '%s' "$email" | tr '[:upper:]' '[:lower:]')"
  [ -n "${RELAY_JWT_SECRET:-}" ] || die "RELAY_JWT_SECRET not set — add it to $CONFIG (the secret shared with the relay Worker)."
  [ -n "${RELAY_URL:-}" ] || die "RELAY_URL not set — add it to $CONFIG (e.g. wss://mcp.wynnset.com/agent)."
  [ -x "$PY" ] || die "No .venv yet — run ./finder install first."

  local token
  token="$(RELAY_JWT_SECRET="$RELAY_JWT_SECRET" "$PY" "$REPO/src/devtoken.py" "$email")" \
    || die "could not mint device token (is RELAY_JWT_SECRET set?)"

  mkdir -p "$PROVISION_DIR"
  local safe bundle
  safe="$(printf '%s' "$email" | tr -c 'a-z0-9' '_')"
  bundle="$PROVISION_DIR/$safe.env"
  cat > "$bundle" <<EOF
# Device credentials for $email — relay reverse-tunnel client.
# SECRET: treat like a password. Copy these two lines into the friend's .finder.env.
RELAY_URL="$RELAY_URL"
RELAY_DEVICE_TOKEN="$token"
EOF
  chmod 600 "$bundle" 2>/dev/null || true

  ok "provisioned $email"
  echo "    bundle: $bundle"
  echo "    relay : $RELAY_URL"
  echo
  warn "two things still needed:"
  echo "    1. Add '$email' to the Worker allowlist:  cd relay && wrangler secret put MCP_ALLOWED_EMAILS"
  echo "       (comma-separated; must match the email they sign into Google with)."
  echo "    2. Ship this bundle into their installer / .finder.env (Step 5 packaging)."
}

cmd_uninstall() {
  bold "Removing auto-start agent"
  svc_stop
  cleanup_old_tunnel
  rm -f "$AGENT_PLIST"
  ok "agent removed (your code, Facebook login, and config are untouched)"
  echo "    If you still have the old cloudflared tunnel, delete it too:"
  echo "        cloudflared tunnel delete marketplace-mcp"
}

cmd_install() {
  load_config
  bold "Installing Marketplace Finder relay agent (auto-start)"
  echo
  bootstrap_python
  echo
  ensure_fb_login
  echo
  ensure_relay_config
  echo
  install_service
  echo
  bold "Done. 🎉  Check it:"
  echo "    ./finder status"
  echo
  bold "Add this ONE URL to claude.ai → Settings → Connectors, then sign in with Google:"
  echo "    $(connector_url)"
}

usage() {
  awk 'NR<=2{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"
}

# ─── dispatch ─────────────────────────────────────────────────────────────────
load_config
case "${1:-}" in
  install)   cmd_install ;;
  start)     svc_start ;;
  stop)      svc_stop ;;
  restart)   svc_restart ;;
  status)    cmd_status ;;
  url)       cmd_url ;;
  logs)      cmd_logs ;;
  login)     cmd_login ;;
  provision) cmd_provision "${2:-}" ;;
  uninstall) cmd_uninstall ;;
  ""|-h|--help|help) usage ;;
  *) err "unknown command: $1"; echo; usage; exit 1 ;;
esac
